// TABLA CALENDARIO
// Modelado > Nueva tabla > pega todo esto.
// Después: clic derecho en la tabla > "Marcar como tabla de fechas" > columna Fecha.

Calendario =
VAR _Inicio = DATE ( 2015, 1, 1 )
VAR _Fin = DATE ( YEAR ( TODAY () ), 12, 31 )
RETURN
    ADDCOLUMNS (
        CALENDAR ( _Inicio, _Fin ),
        "Año", YEAR ( [Date] ),
        "Mes N°", MONTH ( [Date] ),
        "Mes", FORMAT ( [Date], "mmm", "es-PE" ),
        "Año-Mes", FORMAT ( [Date], "yyyy-mm" ),
        "Trimestre", "T" & QUARTER ( [Date] ),
        "Inicio de mes", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
        "Temporada", IF ( MONTH ( [Date] ) IN { 12, 1, 2, 3 }, "Lluvias", "Seca" )
    )

// Luego renombra la columna [Date] a "Fecha" (doble clic en el encabezado).
// Ordena la columna "Mes" por "Mes N°": selecciona Mes > Herramientas de columnas > Ordenar por columna.
