  "background": "#FFFFFF",
  "foreground": "#1E2A35",
  "tableAccent": "#B87333",
  "good": "#2E7D32",
  "neutral": "#F9A825",
  "bad": "#C62828",
  "maximum": "#B87333",
  "center": "#F3E3D3",
  "minimum": "#FFFFFF",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1E2A35" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1E2A35" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A5A68" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F3A5F" }
